table fact_sales_retail
	lineageTag: c21b9dcd-8796-4240-b83e-a3b7e7aed34d

	measure 'Net Revenue' = SUM(fact_sales_retail[revenue])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 70731af5-68a4-4b26-bdc1-6ca3596538b5

		annotation PBI_FormatHint = {"currencyCulture":"it-IT"}

	measure 'Recorded Profit' =
			
			SUM(fact_sales_retail[profit])
		formatString: #,0.000\ "€";-#,0.000\ "€";#,0.000\ "€"
		lineageTag: d3b7a75d-a507-45d2-a9a5-850ebc1edaed

		annotation PBI_FormatHint = {"currencyCulture":"it-IT"}

	measure Receipts =
			
			DISTINCTCOUNT(fact_sales_retail[sale_id])
		formatString: 0
		lineageTag: d9334d34-3ae0-4c5a-9d15-59f3cd7c1ae3

	measure 'Overall Margin' =
			
			DIVIDE(
			    [Recorded Profit],
			    [Net Revenue]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e77ea133-bf18-4391-95f2-7ba575d34a2c

	measure 'Packages Sold' =
			
			SUM(fact_sales_retail[packages])
		formatString: 0
		lineageTag: 01a12525-391f-4593-b8a2-37d69c4eb6e0

	measure 'Selected Ranking Metric' =
			
			SWITCH(
			    SELECTEDVALUE(
			        'Ranking Metric'[Metric],
			        "Recorded profit"
			    ),
			    "Recorded profit", [Recorded Profit],
			    "Net revenue", [Net Revenue],
			    "Packages sold", [Packages Sold]
			)
		lineageTag: e7db20e2-da24-4634-8ab0-630e611be230

		formatStringDefinition =
				IF(
				    SELECTEDVALUE(
				        'Ranking Metric'[Metric],
				        "Recorded profit"
				    ) = "Packages sold",
				    "#,##0",
				    "€ #,##0.000"
				)

	measure 'Distinct Products Sold' =
			
			DISTINCTCOUNT(fact_sales_retail[product_code])
		formatString: 0
		lineageTag: 68d6257e-9eca-46d8-b118-4ab143ad083c

