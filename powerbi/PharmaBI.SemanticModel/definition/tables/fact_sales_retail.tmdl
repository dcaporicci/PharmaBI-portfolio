	partition fact_sales_retail = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(DataFolder & "fact_sales_retail.csv"),[Delimiter=",", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Intestazioni alzate di livello" = Table.PromoteHeaders(Origine, [PromoteAllScalars=true]),
				    #"Modificato tipo" = Table.TransformColumnTypes(#"Intestazioni alzate di livello",{{"date", type date}, {"number_sales", Int64.Type}, {"packages", Int64.Type}}),
				    #"Modificato tipo con impostazioni locali" = Table.TransformColumnTypes(#"Modificato tipo", {{"revenue", Currency.Type}, {"costs", Currency.Type}, {"profit", Currency.Type}}, "en-US"),
				    #"Modificato tipo con impostazioni locali1" = Table.TransformColumnTypes(#"Modificato tipo con impostazioni locali", {{"margin", type number}}, "en-US"),
				    #"Aggiunta colonna personalizzata" = Table.AddColumn(#"Modificato tipo con impostazioni locali1", "atc_level2", each if [atc_code] = null then
				    null
				else
				    Text.Start([atc_code], 3)),
				    #"Modificato tipo1" = Table.TransformColumnTypes(#"Aggiunta colonna personalizzata",{{"atc_level2", type text}}),
				    #"Aggiunta colonna personalizzata1" = Table.AddColumn(#"Modificato tipo1", "is_human_atc", each if [atc_code] = null or Text.Trim([atc_code]) = "" then
				    false
				else
				    not List.Contains(
				        {
				            "P52AC13",
				            "P53AX65",
				            "P54AB51"
				        },
				        [atc_code]
				    )),
				    #"Modificato tipo2" = Table.TransformColumnTypes(#"Aggiunta colonna personalizzata1",{{"is_human_atc", type logical}})
				in
				    #"Modificato tipo2"

	annotation PBI_NavigationStepName = Navigazione

	annotation PBI_ResultType = Table

